# JWT signing/verification secret. Generate one with:
#   openssl rand -hex 32
SECRET_KEY=

# Optional: server port (default 8000)
# PORT=8000

# Optional: SQLite database file path (default ./database.db)
# DATABASE_PATH=./database.db

# Optional: log level (default info). e.g. debug, info, warn, error
# LOG_LEVEL=info
